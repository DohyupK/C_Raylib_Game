<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Win32 NuGet folder is "win32"; x64 libs added under "x64" -->
  <PropertyGroup Condition="'$(Platform)'=='Win32' or '$(Platform)'=='x86'">
    <raylibLib>$(MSBuildThisFileDirectory)lib\win32\</raylibLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <raylibLib>$(MSBuildThisFileDirectory)lib\x64\</raylibLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(raylibLib)'==''">
    <raylibLib>$(MSBuildThisFileDirectory)lib\win32\</raylibLib>
  </PropertyGroup>

  <PropertyGroup Condition="'$(raylib_LibraryType)'=='DynamicRelease'">
    <raylibSuffix>dll</raylibSuffix>
  </PropertyGroup>
  <PropertyGroup>
    <raylib_CoreLibs>
      $(raylibLib)raylib$(raylibSuffix).lib;
      winmm.lib;
      opengl32.lib;
      gdi32.lib;
      shell32.lib;
      user32.lib
    </raylib_CoreLibs>
    <raylib_CoreDLLs>$(raylibLib)raylib.dll</raylib_CoreDLLs>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>
        %(PreprocessorDefinitions);
        PLATFORM_DESKTOP;
        GRAPHICS_API_OPENGL_33
      </PreprocessorDefinitions>
    </ClCompile>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(MSBuildThisFileDirectory)include\;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>
        $(raylib_CoreLibs);
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)\raylibUI.xml" />
  </ItemGroup>

  <!-- Always place DLL next to the exe (and project root) so F5 works on Win32/x64 -->
  <Target Name="CopyRaylibDLL" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(raylib_CoreDLLs)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(raylib_CoreDLLs)')" />
    <Copy SourceFiles="$(raylib_CoreDLLs)" DestinationFolder="$(ProjectDir)..\" SkipUnchangedFiles="true"
          Condition="Exists('$(raylib_CoreDLLs)')" />
  </Target>
</Project>
